{
  "name": "orches-ai-kanban",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs sample-game/tests/*.test.mjs",
    "build": "vite build",
    "dev": "npm run build && node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write \"{server,client,sample-game,scripts,tests}/**/*.{mjs,js,jsx,json,css,html}\" \"{*.mjs,package.json,.github/workflows/test.yml}\"",
    "format:check": "prettier --check \"{server,client,sample-game,scripts,tests}/**/*.{mjs,js,jsx,json,css,html}\" \"{*.mjs,package.json,.github/workflows/test.yml}\""
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "3.8.5"
  }
}
