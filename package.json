{
  "name": "orches-ai-kanban",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "node scripts/check-tests.mjs",
    "build": "vite build",
    "dev": "npm run build && node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "test:browser": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.mjs",
    "format": "prettier --write \"{server,client,sample-game,scripts,tests,docs/trial}/**/*.{mjs,js,jsx,json,css,html}\" \"{*.mjs,package.json,contributor/skills-lock.json,.github/workflows/test.yml}\"",
    "format:check": "prettier --check \"{server,client,sample-game,scripts,tests,docs/trial}/**/*.{mjs,js,jsx,json,css,html}\" \"{*.mjs,package.json,contributor/skills-lock.json,.github/workflows/test.yml}\"",
    "evaluate": "node scripts/evaluate.mjs",
    "setup": "node scripts/setup.mjs",
    "ready": "node scripts/ready.mjs",
    "skills:setup": "node scripts/skills.mjs",
    "pr:edit": "node scripts/github-pr.mjs"
  },
  "dependencies": {
    "express": "^5.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "prettier": "3.8.5"
  }
}
